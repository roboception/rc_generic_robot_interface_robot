MODULE RcSocketCommunication(READONLY)
    !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
    ! Socket Management Functions
    !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!

    LOCAL VAR socketdev client_socket;
    LOCAL VAR bool is_connected := FALSE;

    PROC socket_connect()
        IF is_connected THEN
            ErrWrite \I, "ConnStatus", "Already connected";
        ENDIF

        ! Create and connect socket
        SocketCreate client_socket;
        SocketConnect client_socket, SERVER_IP, SERVER_PORT;
        is_connected := TRUE;

        ErrWrite \I, "ConnInfo", "Connected to " + SERVER_IP + ":" + NumToStr(SERVER_PORT,0);

        ERROR
            IF ERRNO = ERR_SOCK_TIMEOUT THEN
                ErrWrite \W, "ConnTimeout", "Connection timeout";
            ELSEIF ERRNO = ERR_SOCK_CLOSED THEN
                ErrWrite \W, "ConnClosed", "Socket closed unexpectedly";
            ELSE
                ErrWrite \W, "ConnError", "Connection error: " + NumToStr(ERRNO,0);
            ENDIF
    ENDPROC

    PROC socket_disconnect()
        IF is_connected THEN
            WaitTime 0.1;
            SocketClose client_socket;
            is_connected := FALSE;
            ErrWrite \I, "DisconnInfo", "Disconnected";
        ENDIF

        ERROR
            ErrWrite \W, "DisconnError", "Error during disconnect: " + NumToStr(ERRNO,0);
    ENDPROC

    ! Send a request and receive the RESPONSE_MESSAGE_LENGTH byte response
    FUNC bool socket_send_receive(VAR rawbytes request, VAR rawbytes response, \bool debug)
        IF NOT is_connected THEN
            ErrWrite \W, "CommError", "Not connected - cannot send/receive";
            RETURN FALSE;
        ENDIF

        SocketSend client_socket \RawData:=request;

        ClearRawBytes response;
        SocketReceive client_socket \RawData:=response \Time:=SERVER_TIMEOUT;

        IF RawBytesLen(response) <> RESPONSE_MESSAGE_LENGTH THEN
            ErrWrite \W, "LengthError", "Response length: " +
                   NumToStr(RawBytesLen(response),0) +
                   " Expected: " + NumToStr(RESPONSE_MESSAGE_LENGTH,0);
            RETURN FALSE;
        ENDIF

        IF Present(debug) THEN
            IF debug THEN
                print_server_response response;
            ENDIF
        ENDIF

        RETURN TRUE;

        ERROR
            IF ERRNO = ERR_SOCK_TIMEOUT THEN
                ErrWrite \W, "RecvTimeout", "Receive timeout";
            ELSEIF ERRNO = ERR_SOCK_CLOSED THEN
                ErrWrite \W, "RecvClosed", "Socket closed during transfer";
            ELSE
                ErrWrite \W, "RecvError", "Transfer error: " + NumToStr(ERRNO,0);
            ENDIF
            RETURN FALSE;
    ENDFUNC

    ! Message Packing Function (Protocol V1 - 54 bytes total, little-endian)
    PROC request_pack(VAR rawbytes request,
                     num action,
                     num job_id,
                     \robtarget current_pos,
                     \num data1,
                     \num data2,
                     \num data3,
                     \num data4)
        ClearRawBytes request;

        ! Header (bytes 1..8) - write magic as 4 single bytes to avoid any endianness ambiguity
        PackRawBytes 71,  request, 1, \IntX:=SINT;   ! 'G' (0x47)
        PackRawBytes 82,  request, 2, \IntX:=SINT;   ! 'R' (0x52)
        PackRawBytes 73,  request, 3, \IntX:=SINT;   ! 'I' (0x49)
        PackRawBytes 0,   request, 4, \IntX:=SINT;   ! '\0' (0x00)
        PackRawBytes PROTOCOL_VERSION, request, 5, \IntX:=SINT;
        PackRawBytes REQUEST_MESSAGE_LENGTH, request, 6, \IntX:=SINT;
        PackRawBytes POSE_FORMAT_QUAT_WXYZ, request, 7, \IntX:=SINT;
        PackRawBytes action, request, 8, \IntX:=SINT;

        ! job_id uint16 at bytes 9..10
        PackRawBytes job_id, request, 9, \IntX:=2;

        ! Pose (bytes 11..38) and data_1..data_4 (bytes 39..54) are int32 each:
        ! zero them all, then overwrite the fields that were given
        FOR i FROM 11 TO 51 STEP 4 DO
            PackRawBytes 0, request, i, \IntX:=DINT;
        ENDFOR

        IF Present(current_pos) THEN
            ! pos_x, pos_y, pos_z, then QUAT_WXYZ: rot_1..rot_4 = W,X,Y,Z = robtarget q1..q4
            pack_scaled request, 11, current_pos.trans.x;
            pack_scaled request, 15, current_pos.trans.y;
            pack_scaled request, 19, current_pos.trans.z;
            pack_scaled request, 23, current_pos.rot.q1;
            pack_scaled request, 27, current_pos.rot.q2;
            pack_scaled request, 31, current_pos.rot.q3;
            pack_scaled request, 35, current_pos.rot.q4;
        ENDIF

        IF Present(data1) THEN PackRawBytes data1, request, 39, \IntX:=DINT; ENDIF
        IF Present(data2) THEN PackRawBytes data2, request, 43, \IntX:=DINT; ENDIF
        IF Present(data3) THEN PackRawBytes data3, request, 47, \IntX:=DINT; ENDIF
        IF Present(data4) THEN PackRawBytes data4, request, 51, \IntX:=DINT; ENDIF

        ERROR
            ErrWrite \W, "PackError", "Error packing request: " + NumToStr(ERRNO,0);
    ENDPROC

    ! Pack value * 1e6 as signed int32 at index. Goes through dnum because num (float32)
    ! is exact only up to +-8388608.
    LOCAL PROC pack_scaled(VAR rawbytes data, num index, num value)
        VAR dnum scaled;

        scaled := NumToDnum(Round(value * 1000000));
        PackRawBytes scaled, data, index, \IntX:=DINT;
    ENDPROC

    ! Message Unpacking Function (Protocol V1 - 80 bytes total, little-endian)
    ! Fills result with error_code and data_1..data_10, and pose. The header bytes are not read.
    FUNC bool response_unpack(VAR rawbytes response, VAR robtarget pose, VAR gri_result result)
        VAR num value;

        ! error_code int16 signed at bytes 11..12
        UnpackRawBytes response, 11, value, \IntX:=INT;
        result.error_code := value;

        ! Pose (int32 scaled by 1e6): pos_x, pos_y, pos_z, then QUAT_WXYZ rot_1..rot_4 = q1..q4
        pose.trans.x := unpack_dint(response, 13) / 1000000.0;
        pose.trans.y := unpack_dint(response, 17) / 1000000.0;
        pose.trans.z := unpack_dint(response, 21) / 1000000.0;
        pose.rot.q1 := unpack_dint(response, 25) / 1000000.0;
        pose.rot.q2 := unpack_dint(response, 29) / 1000000.0;
        pose.rot.q3 := unpack_dint(response, 33) / 1000000.0;
        pose.rot.q4 := unpack_dint(response, 37) / 1000000.0;
        pose.robconf := [0,0,0,0];
        pose.extax := [0,0,0,0,0,0];

        ! Additional data fields data_1..data_10 (int32)
        result.node_return_code := unpack_dint(response, 41);
        result.remaining_primary := unpack_dint(response, 45);
        result.remaining_related := unpack_dint(response, 49);
        result.data4 := unpack_dint(response, 53);
        result.data5 := unpack_dint(response, 57);
        result.data6 := unpack_dint(response, 61);
        result.data7 := unpack_dint(response, 65);
        result.data8 := unpack_dint(response, 69);
        result.data9 := unpack_dint(response, 73);
        result.data10 := unpack_dint(response, 77);

        RETURN TRUE;

        ERROR
            ErrWrite \W, "UnpackError", "Failed unpacking response";
            RETURN FALSE;
    ENDFUNC

    ! Signed int32 at index
    LOCAL FUNC num unpack_dint(VAR rawbytes data, num index)
        VAR num value;

        UnpackRawBytes data, index, value, \IntX:=DINT;
        RETURN value;
    ENDFUNC
ENDMODULE
