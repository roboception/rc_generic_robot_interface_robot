MODULE RcExampleMainModule
    
    ! Map values of GRI job 2 (must match the "maps" of that job)
    CONST num FRAME_CAMERA := 1;
    CONST num FRAME_EXTERNAL := 2;
    CONST num GRASP_TYPE_SUCTION := 1;
    CONST num ITEM_TYPE_BAG := 1;
    
    ! Write to the event log and, as readable text, to the operator window
    ! (RobotStudio: Controller tab > Operator Window; real robot: FlexPendant).
    LOCAL PROC log_info(string header, string msg)
        ErrWrite \I, header, msg;
        write_operator header, msg;
    ENDPROC

    LOCAL PROC log_warn(string header, string msg)
        ErrWrite \W, header, msg;
        write_operator "WARNING " + header, msg;
    ENDPROC

    LOCAL PROC write_operator(string header, string msg)
        VAR num pos := 1;
        VAR num len;
        VAR num chunk;

        ! TPWrite takes at most 80 characters per line
        IF StrLen(header) + StrLen(msg) + 2 <= 80 THEN
            TPWrite header + ": " + msg;
        ELSE
            TPWrite header + ":";
            ! Longer messages go out in lines of 80 characters
            len := StrLen(msg);
            WHILE pos <= len DO
                chunk := len - pos + 1;
                IF chunk > 80 THEN
                    chunk := 80;
                ENDIF
                TPWrite StrPart(msg, pos, chunk);
                pos := pos + 80;
            ENDWHILE
        ENDIF
    ENDPROC

    PROC main()
        VAR robtarget target1;
        VAR robtarget target2;
        VAR robtarget target3;
        VAR robtarget related_target;
        VAR num job_id_sync := 0;
        VAR num job_id_async := 1;
        VAR num job_status;
        VAR num remaining_primary;
        VAR num remaining_related;
        VAR num node_return_code;
        VAR num attempt;
        VAR bool system_ready;
        VAR bool status_ready;
        VAR num job_id_data := 2;
        VAR robtarget data_target;

        ! Connect to server
        socket_connect;
        
        ! 1. Check overall system STATUS
        log_info "Step1", "Checking overall system STATUS...";
        system_ready := get_status(\ready:=status_ready \debug:=FALSE);
        IF system_ready THEN
            log_info "StatusInfo", "System is ready";
        ELSE
            log_warn "StatusWarning", "System not ready";
        ENDIF
        WaitTime 1;
        
        ! 2. Trigger sync job and get first target
        log_info "Step2", "Triggering synchronous vision job (job_id=" + NumToStr(job_id_sync, 0) + ")...";
        IF trigger_job_sync(job_id_sync, target1 \remaining_primary:=remaining_primary \remaining_related:=remaining_related \node_return_code:=node_return_code \debug:=FALSE) THEN
            print_robtarget "SyncJob_FirstPose", target1;
            log_info "SyncJobInfo", "Remaining primary=" + NumToStr(remaining_primary, 0) + ", related=" + NumToStr(remaining_related, 0) + ", node_return=" + NumToStr(node_return_code, 0);
        ELSE
            log_warn "MainError", "Failed to get first pose from sync job";
            socket_disconnect;
            EXIT;  ! stop the program (RETURN would restart main in continuous run mode)
        ENDIF
        WaitTime 1;
        
        ! 3. Attempt to retrieve a related pose for the synchronous job
        log_info "Step3", "Attempting to retrieve a related pose for the synchronous job...";
        IF get_related_pose(job_id_sync, related_target \remaining_related:=remaining_related \node_return_code:=node_return_code \debug:=FALSE) THEN
            print_robtarget "SyncJob_RelatedPose", related_target;
            log_info "RelatedPoseInfo", "Remaining related=" + NumToStr(remaining_related, 0);
        ELSE
            log_info "RelatedPoseInfo", "No related pose available for sync job";
        ENDIF
        WaitTime 1;
        
        ! 4. Fetch additional poses for the synchronous job
        log_info "Step4", "Fetching additional poses for the synchronous job...";
        FOR attempt FROM 1 TO 3 DO
            IF get_next_pose(job_id_sync, target2 \remaining_primary:=remaining_primary \remaining_related:=remaining_related \node_return_code:=node_return_code \debug:=FALSE) THEN
                print_robtarget "SyncJob_NextPose_" + NumToStr(attempt, 0), target2;
                log_info "NextPoseInfo", "Remaining primary=" + NumToStr(remaining_primary, 0) + ", related=" + NumToStr(remaining_related, 0);
                ! If there are related poses, try to get one
                IF remaining_related > 0 THEN
                    IF get_related_pose(job_id_sync, related_target \remaining_related:=remaining_related \node_return_code:=node_return_code \debug:=FALSE) THEN
                        print_robtarget "SyncJob_FollowUpRelated_" + NumToStr(attempt, 0), related_target;
                    ENDIF
                ENDIF
                ! Stop if no more primary poses
                IF remaining_primary <= 0 THEN
                    log_info "NextPoseInfo", "No more primary poses available";
                    GOTO step4_done;  ! leave the loop (EXIT would stop the whole program)
                ENDIF
            ELSE
                log_info "NextPoseInfo", "No more primary poses reported for sync job";
                GOTO step4_done;  ! leave the loop (EXIT would stop the whole program)
            ENDIF
        ENDFOR
        step4_done:
        WaitTime 1;

        ! 5. Trigger asynchronous vision job
        log_info "Step5", "Triggering asynchronous vision job (job_id=" + NumToStr(job_id_async, 0) + ")...";
        IF trigger_job_async(job_id_async \debug:=FALSE) THEN
            log_info "AsyncJobInfo", "Async job triggered successfully"; 
        ELSE
            log_warn "MainError", "Failed to trigger async job";
            socket_disconnect;
            EXIT;  ! stop the program (RETURN would restart main in continuous run mode)
        ENDIF
        WaitTime 1;

        ! 6. Poll job status once before waiting
        log_info "Step6", "Polling job status once before waiting...";
        job_status := get_job_status(job_id_async \debug:=FALSE);
        TEST job_status
            CASE JOB_STATUS_DONE:
                log_info "JobStatus", "Job completed successfully";
            CASE JOB_STATUS_FAILED:
                log_info "JobStatus", "Job failed";
            CASE JOB_STATUS_RUNNING:
                log_info "JobStatus", "Job is running";
            CASE JOB_STATUS_INACTIVE:
                log_info "JobStatus", "Job is inactive";
            DEFAULT:
                log_info "JobStatus", "Job status unknown";
        ENDTEST
        WaitTime 1;
        
        ! 7. Wait for asynchronous job to complete
        log_info "Step7", "Waiting for asynchronous job to complete...";
        IF NOT wait_for_job(job_id_async \delay:=500 \timeout:=10000 \debug:=FALSE) THEN
            log_warn "MainError", "Job wait timeout or error";
            socket_disconnect;
            EXIT;  ! stop the program (RETURN would restart main in continuous run mode)
        ENDIF
        log_info "WaitInfo", "Job completed";
        WaitTime 1;
        
        ! 8. Retrieving poses produced by the asynchronous job
        log_info "Step8", "Retrieving poses produced by the asynchronous job...";
        FOR attempt FROM 1 TO 5 DO
            IF get_next_pose(job_id_async, target3 \remaining_primary:=remaining_primary \remaining_related:=remaining_related \node_return_code:=node_return_code \debug:=FALSE) THEN
                print_robtarget "AsyncJob_Pose_" + NumToStr(attempt, 0), target3;
                log_info "AsyncPoseInfo", "Remaining primary=" + NumToStr(remaining_primary, 0) + ", related=" + NumToStr(remaining_related, 0);
                ! Try to get related pose
                IF get_related_pose(job_id_async, related_target \remaining_related:=remaining_related \node_return_code:=node_return_code \debug:=FALSE) THEN
                    print_robtarget "AsyncJob_Related_" + NumToStr(attempt, 0), related_target;
                ENDIF
                ! Stop if no more primary poses
                IF remaining_primary <= 0 THEN
                    log_info "AsyncPoseInfo", "No more primary poses available";
                    GOTO step8_done;  ! leave the loop (EXIT would stop the whole program)
                ENDIF
            ELSE
                log_info "AsyncPoseInfo", "No more primary poses reported for async job";
                GOTO step8_done;  ! leave the loop (EXIT would stop the whole program)
            ENDIF
        ENDFOR
        step8_done:

        ! 9. Sync job with dynamic arguments and additional return values (job 2)
        log_info "Step9", "Triggering sync job with dynamic args (job_id=" + NumToStr(job_id_data, 0) + ")...";
        IF trigger_job_sync(job_id_data, data_target \remaining_primary:=remaining_primary \remaining_related:=remaining_related \data1:=gri_float(0.03) \data2:=gri_float(0.03) \data3:=FRAME_EXTERNAL) THEN
            print_robtarget "DataJob_Pose", data_target;
            log_info "DataJobInfo", "Quality=" + NumToStr(gri_to_float(gri_last.data4), 3) + ", grasp type=" + NumToStr(gri_last.data5, 0);
            IF gri_last.data5 = GRASP_TYPE_SUCTION THEN
                log_info "DataJobInfo", "Grasp type is SUCTION";
            ENDIF
            ! int field: raw value, no scaling. num is float32, so values above
            ! 8388608 (like this Unix time) are shown rounded.
            log_info "DataJobInfo", "Detection time (int)=" + NumToStr(gri_last.data6, 0) + " s";
            IF get_related_pose(job_id_data, related_target \remaining_related:=remaining_related) THEN
                log_info "DataJobInfo", "Bounding box x=" + NumToStr(gri_to_float(gri_last.data7) * 1000, 1) + " y=" + NumToStr(gri_to_float(gri_last.data8) * 1000, 1) + " z=" + NumToStr(gri_to_float(gri_last.data9) * 1000, 1) + " mm";
                log_info "DataJobInfo", "Item type=" + NumToStr(gri_last.data10, 0);
                IF gri_last.data10 = ITEM_TYPE_BAG THEN
                    log_info "DataJobInfo", "Item type is BAG";
                ENDIF
            ELSE
                log_warn "DataJobWarn", "Related pose failed: " + get_error_string(gri_last.error_code);
            ENDIF
        ELSE
            log_warn "DataJobWarn", "Sync job failed: " + get_error_string(gri_last.error_code);
        ENDIF
        WaitTime 1;

        ! 10. Async job with dynamic arguments (camera frame)
        log_info "Step10", "Triggering async job with dynamic args (camera frame)...";
        IF trigger_job_async(job_id_data \data1:=gri_float(0.02) \data2:=gri_float(0.02) \data3:=FRAME_CAMERA) THEN
            IF wait_for_job(job_id_data \delay:=500 \timeout:=10000) THEN
                IF get_next_pose(job_id_data, data_target \remaining_primary:=remaining_primary \remaining_related:=remaining_related) THEN
                    print_robtarget "DataJob_CameraFramePose", data_target;
                    log_info "DataJobInfo", "Quality=" + NumToStr(gri_to_float(gri_last.data4), 3);
                ELSE
                    log_warn "DataJobWarn", "Get pose failed: " + get_error_string(gri_last.error_code);
                ENDIF
            ELSE
                log_warn "DataJobWarn", "Job wait timeout or error";
            ENDIF
        ELSE
            log_warn "DataJobWarn", "Async job failed: " + get_error_string(gri_last.error_code);
        ENDIF

        log_info "MainInfo", "Example program finished. Disconnecting.";
        ! Clean disconnect
        socket_disconnect;
        EXIT;  ! run once; continuous run mode would otherwise restart main
        
    ERROR
        log_warn "MainError", "Main failed: " + NumToStr(ERRNO, 0);
        socket_disconnect;
        EXIT;  ! run once; continuous run mode would otherwise restart main
    ENDPROC
ENDMODULE